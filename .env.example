# --- mailbox (Google Workspace). Use an app password (needs 2-step verification) or OAuth.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=something@urmigroup.net
IMAP_PASSWORD=
# comma separated: full addresses or domains
KNOWN_BANK_SENDERS=hasansakib047@gmail.com
REJECT_DMARC_FAIL=true

# --- scheduler
POLL_MINUTES=60
SCHEDULER_ENABLED=true

# --- database (same style as your other project)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Used when running the API outside Docker. Inside Docker, docker-compose.yml overrides the host with "db".
POSTGRES_HOST=localhost
# 5432 is blocked on this PC and 5433 is used by the email-dashboard project
POSTGRES_PORT=5434

# pgAdmin login (email must look real, e.g. admin@example.com)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
# host port for pgAdmin (email-dashboard project uses 5050)
PGADMIN_PORT=5051

# --- LLM fallback (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/ministral-8b-2512

# --- servers (host ports; email-dashboard project uses 8000 and 3000)
# BIND_HOST=0.0.0.0 is set by docker-compose inside Docker; if you expose the API, set API_KEY.
BIND_HOST=127.0.0.1
API_PORT=8001
UI_PORT=8502
API_KEY=
