# ---- Secrets / local settings: docker-compose passes .env at run time (env_file), never bake it into the image
.env
.env.*

# ---- Git and editors
.git
.gitignore
.gitattributes
.vscode
.idea
.DS_Store
**/.DS_Store

# ---- Python junk
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
.venv
venv
env
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
build
dist

# ---- Run-time data: docker-compose mounts these as volumes, they must not be copied into the image
exports
staging
logs
pgdata
data
local.db
*.db
*.sqlite3
erp_state.json
erp_screens
erp_runs

# ---- The web front end is a separate image (./frontend has its own .dockerignore)
frontend
**/node_modules
**/.next

# ---- Archives, docs and Docker files: not needed inside the container
**/*.zip
*.tar
*.tar.gz
**/*.md
Dockerfile
docker-compose*.yml
.dockerignore
dockerignore

# Kept on purpose (small, and handy for `docker compose exec app pytest`): tests, scripts